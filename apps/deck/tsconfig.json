{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@tiller/shared": ["../../packages/shared/src/index.ts"],
      "@tiller/sync-protocol": ["../../packages/sync-protocol/src/index.ts"],
      "@tiller/agent-registry": ["../../packages/agent-registry/src/index.ts"],
      "@tiller/acp-runtime": ["../../packages/acp-runtime/src/index.ts"]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}