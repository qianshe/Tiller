{
  "name": "@tiller/helm",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tiller": "./dist/index.js"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "clean-port": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-port.ps1",
    "dev": "pnpm run clean-port && node scripts/dev-helm.mjs",
    "pack:npm": "pnpm run build && pnpm run smoke:package",
    "publish:npm": "pnpm run build && npm publish ./dist-package --access public",
    "verify:publish-package": "node scripts/verify-publish-package.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "test": "tsx --test src/**/*.test.ts scripts/**/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format:write": "prettier --write \"src/**/*.ts\"",
    "spike:acp-adapter": "node scripts/acp-adapter-spike.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "smoke:runtime:trace": "node scripts/smoke-runtime.mjs --prompt-trace",
    "smoke:contract": "node scripts/contract-smoke.mjs",
    "probe:acp-models": "tsx scripts/probe-codex-models.ts",
    "probe:codex-models": "tsx scripts/probe-codex-models.ts --command codex-acp",
    "probe:opencode-models": "tsx scripts/probe-codex-models.ts --command opencode --arg acp --arg --pure --arg --port --arg 0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.21.0",
    "@tiller/persistence": "workspace:*",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  },
  "description": "Tiller local command deck runtime for ACP coding agents",
  "keywords": [
    "tiller",
    "agent",
    "acp",
    "coding-agent",
    "command-deck",
    "local-first"
  ],
  "license": "Apache-2.0",
  "author": "qianshe",
  "homepage": "https://github.com/qianshe/Tiller#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qianshe/Tiller.git"
  },
  "bugs": {
    "url": "https://github.com/qianshe/Tiller/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
