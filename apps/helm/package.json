{
  "name": "@tiller/helm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean-port": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-port.ps1",
    "dev": "pnpm run clean-port && tsx watch src/index.ts",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "probe:acp-models": "tsx scripts/probe-codex-models.ts",
    "probe:codex-models": "tsx scripts/probe-codex-models.ts --command codex-acp",
    "probe:opencode-models": "tsx scripts/probe-codex-models.ts --command opencode --arg acp --arg --pure --arg --port --arg 0"
  },
  "dependencies": {
    "@tiller/acp-runtime": "workspace:*",
    "@tiller/agent-registry": "workspace:*",
    "@tiller/shared": "workspace:*",
    "@tiller/sync-protocol": "workspace:*",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  }
}
